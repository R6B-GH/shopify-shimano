<wishlist-action>
  <a href="{{ routes.account_url }}" class="c_product-item__fav" aria-label="マイページを開く" title="マイページを開く">{{ heart_icon }}</a>
  <button hidden type="button" class="c_product-item__fav swym-button swym-add-to-wishlist-view-product product_{{ product.id }}"
    aria-label="お気に入りに追加" data-swaction="addToWishlist" data-product-id="{{ product.id }}"
    data-variant-id="{{ product.selected_or_first_available_variant.id }}" data-product-url="{{ shop.url }}{{ product.url }}">
    {{ heart_icon }}
  </button>
</wishlist-action>
