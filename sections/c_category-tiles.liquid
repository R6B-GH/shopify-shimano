{%- comment -%}
--------------------------------------------------------
  CSS
{%- endcomment -%}
{{ 'c_category-tiles.css' | asset_url | stylesheet_tag }}

{%- comment -%}
--------------------------------------------------------
  インラインスタイル（動的な余白・背景色）
{%- endcomment -%}
{%- style -%}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.background }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .c_category-tiles__list {
    --c-category-columns: {{ section.settings.columns }};
  }
  @media screen and (max-width: 740px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_sp }}px;
      padding-bottom: {{ section.settings.padding_bottom_sp }}px;
    }
  }
{%- endstyle -%}

{%- comment -%}
--------------------------------------------------------
  HTML
{%- endcomment -%}
<section id="c_category-tiles-{{ section.id }}" class="c_category-tiles c_section">
  <div class="c_container">
    {% render 'c_section__header',
      title: section.settings.title,
      subtitle: section.settings.subtitle,
      link_url: section.settings.link_url,
      link_text: section.settings.link_text
    %}

    {%- if section.blocks.size > 0 -%}
      <ul class="c_category-tiles__list" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign tile_collection = block.settings.collection
            assign tile_image = block.settings.image | default: tile_collection.featured_image
            assign tile_title = block.settings.title | default: tile_collection.title
            assign tile_link = block.settings.link | default: tile_collection.url
          -%}
          <li class="c_category-tiles__item" {{ block.shopify_attributes }}>
            <a class="c_category-tiles__link" href="{{ tile_link | default: '#' }}">
              <span class="c_category-tiles__media">
                {%- if tile_image != blank -%}
                  {{- tile_image | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '(max-width: 740px) 40vw, 230px', widths: '200,300,400,500,600', class: 'c_category-tiles__image', alt: '' -}}
                {%- else -%}
                  {%- capture placeholder_name -%}collection-{{ forloop.index | modulo: 6 | plus: 1 }}{%- endcapture -%}
                  {{- placeholder_name | placeholder_svg_tag: 'c_category-tiles__image c_category-tiles__placeholder' -}}
                {%- endif -%}
              </span>
              <span class="c_category-tiles__title">{{ tile_title | default: 'カテゴリー名' | escape }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- elsif request.design_mode -%}
      <p>カテゴリーを追加してください</p>
    {%- endif -%}

    {% render 'c_section__footer', link_url: section.settings.link_url, link_text: section.settings.link_text %}
  </div>
</section>

{% schema %}
{
  "name": "カスタム:カテゴリー一覧",
  "class": "c_section c_section--category-tiles",
  "tag": "div",
  "max_blocks": 12,
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "サブ見出し（日本語）",
      "default": "カテゴリー"
    },
    {
      "type": "text",
      "id": "title",
      "label": "見出し（英字）",
      "default": "CATEGORY"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "リンクテキスト"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "リンク先"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "PCの列数",
      "min": 3,
      "max": 8,
      "step": 1,
      "default": 6
    },
    {
      "type": "color",
      "id": "background",
      "label": "背景色",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "header",
      "content": "余白"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "上部の余白(PC)",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 100,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "下部の余白(PC)",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 50,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_sp",
      "label": "上部の余白(SP)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_sp",
      "label": "下部の余白(SP)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 30,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "カテゴリー",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "コレクション",
          "info": "画像・名前・リンクを未入力の場合はコレクションの情報を使用します。"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "画像",
          "info": "推奨サイズ：460 × 590px（縦長）"
        },
        {
          "type": "text",
          "id": "title",
          "label": "カテゴリー名"
        },
        {
          "type": "url",
          "id": "link",
          "label": "リンク"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "カスタム:カテゴリー一覧",
      "category": "カスタムパーツ",
      "blocks": [
        { "type": "category", "settings": { "title": "ウェア・フットウェア" } },
        { "type": "category", "settings": { "title": "クーラーボックス" } },
        { "type": "category", "settings": { "title": "バッグ・ケース・収納用品" } }
      ]
    }
  ]
}
{% endschema %}
