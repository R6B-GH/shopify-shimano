{%- comment -%}
--------------------------------------------------------
  CSS
{%- endcomment -%}
{{ 'c_news-list.css' | asset_url | stylesheet_tag }}

{%- comment -%}
--------------------------------------------------------
  インラインスタイル（動的な余白・背景色）
{%- endcomment -%}
{%- style -%}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.background }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 740px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_sp }}px;
      padding-bottom: {{ section.settings.padding_bottom_sp }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign blog = section.settings.blog
  assign link_url = section.settings.link_url | default: blog.url
-%}

{%- comment -%}
--------------------------------------------------------
  HTML
{%- endcomment -%}
<section id="c_news-list-{{ section.id }}" class="c_news-list c_section">
  <div class="c_container c_news-list__inner">
    <div class="c_news-list__head">
      {% render 'c_section__header',
        title: section.settings.title,
        subtitle: section.settings.subtitle
      %}
      {%- if link_url != blank and section.settings.link_text != blank -%}
        <a class="c_link-more c_news-list__more" href="{{ link_url }}">{{ section.settings.link_text | escape }}</a>
      {%- endif -%}
    </div>

    <ul class="c_news-list__list" role="list">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <li class="c_news-list__item" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}<a class="c_news-list__link" href="{{ block.settings.link }}">{%- else -%}<div class="c_news-list__link">{%- endif -%}
              <span class="c_news-list__date">{{ block.settings.date | escape }}</span>
              <span class="c_news-list__title">{{ block.settings.title | escape }}</span>
            {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
          </li>
        {%- endfor -%}
      {%- elsif blog != blank and blog.articles_count > 0 -%}
        {%- for article in blog.articles limit: section.settings.articles_count -%}
          <li class="c_news-list__item">
            <a class="c_news-list__link" href="{{ article.url }}">
              <time class="c_news-list__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%Y.%m.%d' }}</time>
              <span class="c_news-list__title">{{ article.title | escape }}</span>
            </a>
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <li class="c_news-list__item">
            <div class="c_news-list__link">
              <span class="c_news-list__date">2026.12.18</span>
              <span class="c_news-list__title">ブログを選択するとお知らせが表示されます</span>
            </div>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>

    {% render 'c_section__footer', link_url: link_url, link_text: section.settings.link_text %}
  </div>
</section>

{% schema %}
{
  "name": "カスタム:お知らせ",
  "class": "c_section c_section--news-list",
  "tag": "div",
  "max_blocks": 10,
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "ブログの最新記事をお知らせとして表示します。ブロックを追加した場合はブロックの内容を優先して表示します。"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "サブ見出し（日本語）",
      "default": "お知らせ"
    },
    {
      "type": "text",
      "id": "title",
      "label": "見出し（英字）",
      "default": "NEWS"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "ブログ"
    },
    {
      "type": "range",
      "id": "articles_count",
      "label": "表示する記事数",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "リンクテキスト",
      "default": "VIEW MORE"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "リンク先",
      "info": "未入力の場合はブログ一覧へリンクします。"
    },
    {
      "type": "color",
      "id": "background",
      "label": "背景色",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "header",
      "content": "余白"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "上部の余白(PC)",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 100,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "下部の余白(PC)",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 76,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_sp",
      "label": "上部の余白(SP)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_sp",
      "label": "下部の余白(SP)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 40,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "news",
      "name": "お知らせ",
      "settings": [
        {
          "type": "text",
          "id": "date",
          "label": "日付",
          "default": "2026.12.18"
        },
        {
          "type": "text",
          "id": "title",
          "label": "タイトル",
          "default": "お知らせのタイトルが入ります"
        },
        {
          "type": "url",
          "id": "link",
          "label": "リンク"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "カスタム:お知らせ",
      "category": "カスタムパーツ"
    }
  ]
}
{% endschema %}
