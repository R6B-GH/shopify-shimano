{%- comment -%}
--------------------------------------------------------
  カスタム:フッター
  Focal標準の footer.liquid を複製し、SHIMANOデザイン（黒背景・ロゴ＋リンク列＋メルマガ）に再構成
  - メルマガ登録フォーム／SNSアイコンは Focal の仕組み（customer フォーム・social-media スニペット）をそのまま利用
{%- endcomment -%}
{{ 'c_footer.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --c-footer-bg: {{ section.settings.background }};
    --c-footer-text: {{ section.settings.text_color }};
    --c-footer-link: {{ section.settings.link_color }};
  }
{%- endstyle -%}

<footer class="c_footer" role="contentinfo">
  <div class="c_container">
    <div class="c_footer__top">
      {%- comment -%} ロゴ・キャッチ {%- endcomment -%}
      <div class="c_footer__brand">
        <a class="c_footer__logo" href="{{ routes.root_url }}">
          {%- if section.settings.logo != blank -%}
            {%- capture logo_style -%}max-width: {{ section.settings.logo_width }}px{%- endcapture -%}
            {{- section.settings.logo | image_url: width: 600 | image_tag: loading: 'lazy', alt: shop.name, style: logo_style -}}
          {%- else -%}
            <span class="c_footer__logo-text c_font-en">{{ shop.name | upcase }}</span>
          {%- endif -%}
        </a>
        {%- if section.settings.tagline != blank -%}
          <p class="c_footer__tagline">{{ section.settings.tagline | escape }}</p>
        {%- endif -%}
      </div>

      {%- comment -%} リンク列（ブロック） {%- endcomment -%}
      <div class="c_footer__nav">
        {%- for block in section.blocks -%}
          {%- if block.type == 'links' -%}
            {%- assign menu = block.settings.menu -%}
            <div class="c_footer__column" {{ block.shopify_attributes }}>
              <details class="c_footer__accordion" open>
                <summary class="c_footer__heading">{{ block.settings.title | default: menu.title | escape }}</summary>
                {%- if menu.links.size > 0 -%}
                  <ul class="c_footer__links" role="list">
                    {%- for link in menu.links -%}
                      <li><a class="c_footer__link" href="{{ link.url }}">{{ link.title | escape }}</a></li>
                    {%- endfor -%}
                  </ul>
                {%- elsif request.design_mode -%}
                  <p class="c_footer__link">メニューを選択してください</p>
                {%- endif -%}
              </details>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- comment -%} メルマガ・SNS {%- endcomment -%}
      <div class="c_footer__newsletter">
        {%- if section.settings.show_newsletter -%}
          <p class="c_footer__newsletter-title c_font-en">{{ section.settings.newsletter_title | escape }}</p>
          {%- if section.settings.newsletter_text != blank -%}
            <p class="c_footer__newsletter-text">{{ section.settings.newsletter_text | escape }}</p>
          {%- endif -%}

          {%- form 'customer', id: 'c-footer-newsletter', class: 'c_footer__form' -%}
            {%- if form.posted_successfully? -%}
              <p class="c_footer__form-message">{{ 'footer.newsletter.success' | t }}</p>
            {%- else -%}
              {%- if form.errors -%}
                <p class="c_footer__form-message c_footer__form-message--error">{{ form.errors.translated_fields['email'] }} {{ form.errors.messages['email'] }}</p>
              {%- endif -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <label for="c-footer-email" class="c_visually-hidden">{{ section.settings.newsletter_placeholder | escape }}</label>
              <input id="c-footer-email" class="c_footer__input" type="email" name="contact[email]" autocomplete="email" required placeholder="{{ section.settings.newsletter_placeholder | escape }}">
              <button type="submit" class="c_footer__submit" aria-label="{{ 'footer.newsletter.submit' | t | escape }}">
                <svg width="6" height="9" viewBox="0 0 6 9" fill="none" aria-hidden="true"><path d="m1 1 3.5 3.5L1 8" stroke="currentColor" stroke-width="1.4"/></svg>
              </button>
            {%- endif -%}
          {%- endform -%}
        {%- endif -%}

        {%- if section.settings.show_social_media -%}
          <div class="c_footer__social">
            {%- render 'social-media' -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="c_footer__bottom">
      <p class="c_footer__copyright">{{ section.settings.copyright | default: shop.name | escape }}</p>
    </div>
  </div>
</footer>

<script>
  (() => {
    /* SPではリンク列のアコーディオンを閉じた状態にする */
    if (!window.matchMedia('(max-width: 740px)').matches) return;
    document.querySelectorAll('#shopify-section-{{ section.id }} .c_footer__accordion[open]').forEach((el) => el.removeAttribute('open'));
  })();
</script>

{% schema %}
{
  "name": "カスタム:フッター",
  "class": "shopify-section--footer",
  "max_blocks": 5,
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "ロゴ（白）",
      "info": "黒背景に表示するため白いロゴを設定します。未設定の場合はショップ名を表示します。"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "ロゴの幅",
      "min": 60,
      "max": 300,
      "step": 2,
      "unit": "px",
      "default": 140
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "ロゴ下のテキスト",
      "default": "シマノ公式オンラインショップ"
    },
    {
      "type": "header",
      "content": "メールマガジン"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "メールマガジン登録を表示",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "見出し（英字）",
      "default": "MAIL MAGAZINE"
    },
    {
      "type": "text",
      "id": "newsletter_text",
      "label": "説明文",
      "default": "新商品・限定商品の情報をお届けします。"
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "入力欄のプレースホルダー",
      "default": "メールアドレス"
    },
    {
      "type": "checkbox",
      "id": "show_social_media",
      "label": "SNSアイコンを表示",
      "info": "各SNSのURLは「テーマ設定＞ソーシャルメディア」で設定します。",
      "default": true
    },
    {
      "type": "header",
      "content": "コピーライト・カラー"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "コピーライト",
      "default": "© SHIMANO INC. All Rights Reserved."
    },
    {
      "type": "color",
      "id": "background",
      "label": "背景色",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "文字色",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "リンクの文字色",
      "default": "#aaaaaa"
    }
  ],
  "blocks": [
    {
      "type": "links",
      "name": "リンク列",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "見出し",
          "info": "未入力の場合はメニュー名を表示します。"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "メニュー"
        }
      ]
    }
  ]
}
{% endschema %}
