{%- comment -%}
--------------------------------------------------------
  CSS / JS
{%- endcomment -%}
{{ 'c_collection-tabs.css' | asset_url | stylesheet_tag }}
<script src="{{ 'c_collection-tabs.js' | asset_url }}" defer></script>

{%- comment -%}
--------------------------------------------------------
  インラインスタイル（動的な余白・背景色）
{%- endcomment -%}
{%- style -%}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.background }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 740px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_sp }}px;
      padding-bottom: {{ section.settings.padding_bottom_sp }}px;
    }
  }
{%- endstyle -%}

{%- comment -%}
--------------------------------------------------------
  初期表示タブの決定（「初期表示」にチェックしたタブ → 最初のタブ）
{%- endcomment -%}
{%- liquid
  assign active_block = section.blocks.first
  for block in section.blocks
    if block.settings.is_default
      assign active_block = block
      break
    endif
  endfor
  assign active_link = active_block.settings.link_url | default: active_block.settings.collection.url | default: active_block.settings.category_collection.url | default: section.settings.collection.url
  assign products_limit = section.settings.products_count
-%}

{%- comment -%}
--------------------------------------------------------
  HTML
{%- endcomment -%}
<c-collection-tabs id="c_collection-tabs-{{ section.id }}" class="c_collection-tabs c_section" data-section-id="{{ section.id }}">
  <div class="c_container">
    {% render 'c_section__header',
      title: section.settings.title,
      subtitle: section.settings.subtitle,
      tabs: section.blocks,
      active_block_id: active_block.id,
      section_id: section.id,
      link_url: active_link,
      link_text: section.settings.link_text
    %}

    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign is_active = false
          if block.id == active_block.id
            assign is_active = true
          endif

          comment
            表示する商品の決め方
            1. タブに「コレクション」があればそのコレクションの商品
            2. なければセクションの「基準コレクション」の商品を「絞り込みタグ」で絞り込む（タグ未入力ならすべて）
          endcomment
          assign filter_tag = block.settings.filter_tag | strip
          assign tab_collection = block.settings.collection
          if tab_collection != blank
            assign filter_tag = ''
          else
            assign tab_collection = section.settings.collection
          endif

          assign tab_link = block.settings.link_url
          if tab_link == blank
            if block.settings.collection != blank
              assign tab_link = block.settings.collection.url
            elsif filter_tag != blank and block.settings.category_collection != blank
              assign tab_link = block.settings.category_collection.url
            else
              assign tab_link = section.settings.collection.url
            endif
          endif
        -%}
        <div
          class="c_collection-tabs__panel"
          id="c_panel-{{ section.id }}-{{ block.id }}"
          {% if section.blocks.size > 1 %}role="tabpanel" aria-labelledby="c_tab-{{ section.id }}-{{ block.id }}"{% endif %}
          data-panel-id="{{ block.id }}"
          data-panel-link="{{ tab_link }}"
          {% unless is_active %}hidden{% endunless %}
        >
          {%- if tab_collection != blank -%}
            {%- comment -%} 表示件数を先に数える（4点以上ならFocal標準のスライダーにする） {%- endcomment -%}
            {%- assign total = 0 -%}
            {%- for product in tab_collection.products -%}
              {%- if filter_tag != blank -%}
                {%- unless product.tags contains filter_tag -%}{%- continue -%}{%- endunless -%}
              {%- endif -%}
              {%- if total >= products_limit -%}{%- break -%}{%- endif -%}
              {%- assign total = total | plus: 1 -%}
            {%- endfor -%}

            {%- capture items_html -%}
              {%- assign shown = 0 -%}
              {%- for product in tab_collection.products -%}
                {%- if filter_tag != blank -%}
                  {%- unless product.tags contains filter_tag -%}{%- continue -%}{%- endunless -%}
                {%- endif -%}
                {%- if shown >= products_limit -%}{%- break -%}{%- endif -%}
                {%- assign shown = shown | plus: 1 -%}
                <li class="c_collection-tabs__item">
                  {%- render 'c_product-item', product: product, badge: section.settings.badge, index: shown -%}
                </li>
              {%- endfor -%}
            {%- endcapture -%}

            {%- if total >= 4 -%}
              <product-list class="product-list c_collection-tabs__slider">
                <div class="scroller">
                  <ul class="product-list__inner product-list__inner--scroller hide-scrollbar" role="list">
                    {{- items_html -}}
                  </ul>
                </div>

                {%- if total > 4 -%}
                  <prev-next-buttons class="product-list__prev-next hidden-pocket">
                    <button type="button" class="product-list__arrow prev-next-button prev-next-button--prev" disabled>
                      <span class="visually-hidden">{{ 'general.accessibility.previous' | t }}</span>
                      {%- render 'icon' with 'nav-arrow-left', block: true, direction_aware: true -%}
                    </button>
                    <button type="button" class="product-list__arrow prev-next-button prev-next-button--next">
                      <span class="visually-hidden">{{ 'general.accessibility.next' | t }}</span>
                      {%- render 'icon' with 'nav-arrow-right', block: true, direction_aware: true -%}
                    </button>
                  </prev-next-buttons>
                {%- endif -%}
              </product-list>
            {%- elsif total > 0 -%}
              <ul class="c_collection-tabs__list" role="list">
                {{- items_html -}}
              </ul>
            {%- else -%}
              <p class="c_collection-tabs__empty">現在、該当する商品はありません。</p>
            {%- endif -%}
          {%- else -%}
            <ul class="c_collection-tabs__list" role="list">
              {%- for i in (1..products_limit) -%}
                <li class="c_collection-tabs__item">
                  {%- render 'c_product-item', product: blank, badge: section.settings.badge, index: forloop.index, placeholder_index: forloop.index -%}
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endfor -%}
    {%- elsif request.design_mode -%}
      <p>タブ（コレクション）を追加してください</p>
    {%- endif -%}

    {% render 'c_section__footer', link_url: active_link, link_text: section.settings.link_text %}
  </div>
</c-collection-tabs>

{% schema %}
{
  "name": "カスタム:商品一覧タブ",
  "class": "c_section c_section--collection-tabs",
  "tag": "div",
  "max_blocks": 8,
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "コレクションごとのタブで商品を切り替えて表示します。近日発売・新着・ランキング・おすすめなどに使用します。"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "サブ見出し（日本語）",
      "default": "近日発売"
    },
    {
      "type": "text",
      "id": "title",
      "label": "見出し（英字）",
      "default": "COMING SOON"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "基準コレクション",
      "info": "近日発売・新着などのコレクション。各タブはこのコレクションを「絞り込みタグ」で絞り込んで表示します。"
    },
    {
      "type": "select",
      "id": "badge",
      "label": "商品カードのラベル",
      "options": [
        { "value": "none", "label": "表示しない" },
        { "value": "coming_soon", "label": "COMING SOON" },
        { "value": "new", "label": "NEW" },
        { "value": "rank", "label": "順位（1, 2, 3…）" }
      ],
      "default": "coming_soon"
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "表示する商品数",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 12,
      "info": "4点以上ある場合はスライダーで表示します。"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "リンクテキスト",
      "default": "VIEW MORE",
      "info": "リンク先は表示中のタブのコレクションになります。"
    },
    {
      "type": "color",
      "id": "background",
      "label": "背景色",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "header",
      "content": "余白"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "上部の余白(PC)",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 50,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "下部の余白(PC)",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 50,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_sp",
      "label": "上部の余白(SP)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_sp",
      "label": "下部の余白(SP)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 30,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "タブ",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "タブ名",
          "default": "すべて",
          "info": "未入力の場合はコレクション名を表示します。"
        },
        {
          "type": "text",
          "id": "filter_tag",
          "label": "絞り込みタグ",
          "info": "基準コレクションの中から、このタグを持つ商品だけを表示します（例：ウェア/フットウェア）。空欄ならすべて表示。"
        },
        {
          "type": "collection",
          "id": "category_collection",
          "label": "VIEW MOREのリンク先コレクション",
          "info": "絞り込みタグ使用時のリンク先（例：ウェア/フットウェア）。"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "コレクション（個別指定）",
          "info": "設定すると基準コレクション・絞り込みタグより優先して、このコレクションを表示します。"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "VIEW MOREのリンク先",
          "info": "未入力の場合はコレクションページへリンクします。"
        },
        {
          "type": "checkbox",
          "id": "is_default",
          "label": "初期表示のタブにする",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "カスタム:商品一覧タブ",
      "category": "カスタムパーツ",
      "blocks": [
        { "type": "tab", "settings": { "title": "すべて" } },
        { "type": "tab", "settings": { "title": "ウェア・フットウェア" } },
        { "type": "tab", "settings": { "title": "クーラーボックス" } },
        { "type": "tab", "settings": { "title": "バッグ・ケース・収納用品" } }
      ]
    }
  ]
}
{% endschema %}
